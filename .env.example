# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SWE_ADMIN_TOKEN=replace-with-a-random-token-at-least-24-characters
SWE_DATA_DIR=./data
SWE_MODELS_FILE=./config/models.json
# Full local Docker development (copy config/models.json to models.local.json):
# SWE_MODELS_FILE=./models.local.json
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
# COMPOSE_PROFILES=local-worker
# Only the worker needs inference credentials. Never put keys in model JSON.
GATEWAY_API_KEY=
SECONDARY_GATEWAY_API_KEY=
# Optional: administrator-installed task directory (do not accept client tasks).
# SWE_TASK_DIR=/absolute/path/to/trusted-tasks

# Phase 2 standalone dashboard: hash a separate console password using getpass
# and swe_eval.sessions.password_hash (see PHASE2_DEPLOYMENT_GUIDE.md).
SWE_UI_PASSWORD_HASH=
SWE_PUBLIC_ORIGIN=https://swe.example.com
SWE_COOKIE_SECURE=true
# Separate read-only credential for shadow-router exports, >=24 random characters.
SWE_SHADOW_TOKEN=
SWE_MAX_BATCH_RUNS=100
SWE_MAX_PENDING_RUNS=200
SWE_MAX_BATCH_DURATION=86400
SWE_MAX_BATCH_REQUESTS=10000
# Optional server-side mapping file; mount it explicitly into API container.
# SWE_INTEGRATION_FILE=/app/config/sub2api.json
